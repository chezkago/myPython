#class solution
def is_prime(num): #2
    if num < 4:
        return True
    if num % 2 == 0:
        return False
    for i in range(3, num // 2, 2):
        if num % i == 0:
            return False
        return True
    

for i in range(2, 20):
    if is_prime(i):
        print(f"{i} | is prime? {is_prime(i)}")


